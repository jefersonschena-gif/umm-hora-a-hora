# Copie para .env e preencha. O .env fica fora do git.
# Nenhuma chave é obrigatória: a fonte "archive" funciona sem chave nenhuma.

# YouTube Data API v3 — https://console.cloud.google.com/apis/library/youtube.googleapis.com
# Cota gratuita de 10.000 unidades/dia (cada busca custa ~100).
YOUTUBE_API_KEY=

# Pexels — https://www.pexels.com/api/ (gratuito)
PEXELS_API_KEY=

# Pixabay — https://pixabay.com/api/docs/ (gratuito)
PIXABAY_API_KEY=
